CREATEOS_SANDBOX_BASE_URL=https://api.sb.createos.sh
CREATEOS_SANDBOX_API_KEY=your-createos-sandbox-api-key

# OpenAI drives the agent loop on the host.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Optional: provide your own Anchor key. If omitted, the example uses Anchor
# Agent Access and asks OpenAI to solve the short challenge for a trial key.
# ANCHOR_API_KEY=sk-your-anchor-api-key

# Optional: override the page the agent should scrape.
# TARGET_URL=https://example.com
