# ── createos-sandbox control plane ──────────────────────────────────────────
CREATEOS_SANDBOX_BASE_URL=https://your-control-plane.example.com
CREATEOS_SANDBOX_API_KEY=your-api-key

# ── S3-compatible bucket for the tamper-evident audit disk ──────────────────
# Any S3-compatible store reachable from the createos-sandbox agent works
# (AWS S3 / R2 / MinIO). The MinIO public playground is a quick default.
S3_BUCKET=your-bucket
S3_ENDPOINT=https://play.min.io
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# set to 1 for MinIO / path-style endpoints
S3_USE_PATH_STYLE=1

# ── Anthropic-compatible LLM proxy for the live governed-agent turn ─────────
# The agent uses @anthropic-ai/sdk pointed at this base URL; a non-Anthropic
# model behind an Anthropic-compatible proxy is fine. The LLM turn is
# best-effort — the deterministic governance demo runs even without it.
ANTHROPIC_BASE_URL=https://your-llm-proxy.example.com
ANTHROPIC_AUTH_TOKEN=your-proxy-token
ANTHROPIC_MODEL=your-model-id
